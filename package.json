{
  "name": "romantic-birthday-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:qr && npm run validate && vite build && node scripts/finalize-service-worker.mjs",
    "preview": "vite preview",
    "preview:e2e": "node scripts/serve-dist.mjs",
    "validate": "node scripts/validate-gift.mjs",
    "generate:qr": "node scripts/generate-share-qr.mjs",
    "optimize": "npm run optimize:images",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test": "node --test",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@mediapipe/hands": "0.4.1675469240",
    "canvas-confetti": "1.9.4",
    "gsap": "3.15.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "qrcode": "1.5.4",
    "sharp": "0.34.5",
    "vite": "7.3.6"
  }
}
