{
  "name": "romantic-birthday-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve-dist.mjs",
    "dev:birthday": "vite",
    "build": "node scripts/build-composite.mjs",
    "build:release": "npm run validate:september:release && npm run build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "preview": "vite preview",
    "preview:e2e": "node scripts/serve-dist.mjs",
    "validate": "node scripts/validate-source.mjs",
    "validate:dist": "node scripts/validate-build.mjs",
    "validate:remote": "node scripts/validate-build.mjs --base-url",
    "generate:qr": "node scripts/generate-share-qr.mjs",
    "optimize": "npm run optimize:images",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:birthday": "node --test tests/unit/*.test.js",
    "test:august": "npm --prefix apps/august test",
    "test:september": "npm --prefix apps/september test",
    "validate:september:release": "npm --prefix apps/september run validate:release",
    "test": "npm run test:birthday && npm run test:august && npm run test:september",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.8",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/playfair-display": "5.2.8",
    "@mediapipe/hands": "0.4.1675469240",
    "canvas-confetti": "1.9.4",
    "grapheme-splitter": "1.0.4",
    "gsap": "3.15.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "qrcode": "1.5.4",
    "sharp": "0.34.5",
    "vite": "7.3.6"
  }
}
