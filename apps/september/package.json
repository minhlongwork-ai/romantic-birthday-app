{
  "name": "september-sweet-and-bloom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "check": "node --check src/main.js && node --check src/ui/scenes.js && node --check src/ui/puzzle-controller.js && node --check scripts/validate.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:release": "node scripts/validate.mjs --release",
    "generate:content": "node scripts/generate-release-content.mjs",
    "check:content": "node scripts/generate-release-content.mjs --check",
    "generate:media": "node scripts/generate-product-media.mjs",
    "check:media": "node scripts/generate-product-media.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "qa": "npm run check && npm run validate && npm test"
  }
}
